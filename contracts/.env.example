# Organizatör (deploy eden) cüzdanın private key'i — test MON yüklü olmalı. ASLA commit etme.
PRIVATE_KEY=0x...
# Monad testnet — docs.monad.xyz/developer-essentials/testnet
# alternatifler: https://rpc.ankr.com/monad_testnet · https://rpc-testnet.monadinfra.com
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
# deploy sonrası scriptler buradan okur
BLITZVOTE_ADDRESS=

# --- make-voters ayarları (Windows'ta da çalışsın diye buradan veriyoruz) ---
# QR'ların açacağı adres (Vercel'e deploy ettiğin frontend)
APP_URL=http://localhost:5173
AUDIENCE=60
TEAM_QR=1
REACTIONS=15
# npm run rehearse çıktısındaki öneriyle güncelle
VOTE_GAS=175000
REACT_GAS=55000
# Monadscan doğrulaması için (opsiyonel, MonadVision anahtarsız çalışır)
ETHERSCAN_API_KEY=
# DRY_RUN=1   # sadece maliyeti göster
